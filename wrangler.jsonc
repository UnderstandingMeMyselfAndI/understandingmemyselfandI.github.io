{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ummi-app",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist/",

    "not_found_handling": "single-page-application",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
