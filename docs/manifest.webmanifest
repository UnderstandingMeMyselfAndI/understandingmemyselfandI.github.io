{"name":"Ummi","short_name":"Ummi","description":"Understanding Me Myself & I (Ummi) is a companion app providing support for mental health and addiction recovery. It provides quick access to tools and skills learnt in SMART, Cognitive Behavioural Therapy (CBT), Acceptance Commitment Therapy (ACT), Dialectical Behaviour Therapy (DBT) and others.","start_url":"/index.html?fullscreen=true","display":"fullscreen","background_color":"#1b1b1b","theme_color":"#1b1b1b","lang":"en","scope":"/","filename":"manifest.webmanifest","id":"/","launch_handler":{"client_mode":["navigate-existing","focus-existing","auto"]},"capture_links":"existing_client_event","url_handlers":[{"origin":"https://www.ummi.now"}],"shortcuts":[{"name":"Tools","url":"tools"},{"name":"Days Counter","url":"days-counter"},{"name":"Units Calculator","url":"units-calculator"},{"name":"Wallpapers","url":"wallpaper-gallery"},{"name":"Settings","url":"settings"},{"name":"Lingo & Phrases","url":"lingo-and-phrases"},{"name":"Share","url":"share"},{"name":"Install Ummi","url":"install"},{"name":"Recovery Timeline","url":"recovery-timeline"},{"name":"Wheel of Life","url":"wheel-of-life"},{"name":"The BIG Recovery Quiz!","url":"quiz"}],"handle_links":["preferred","auto"],"orientation":"portrait","dir":"ltr","display_override":["window-controls-overlay"],"share_target":{"action":"/s","method":"GET","enctype":"application/x-www-form-urlencoded","params":{"title":"title","text":"text"}},"icons":[{"src":"/icons/UmmiIcon2.svg","sizes":"any","type":"image/svg+xml"},{"src":"/icons/pwa-512x512.avif","sizes":"512x512","type":"image/avif"},{"src":"/icons/pwa-512x512.png","sizes":"512x512","type":"image/png"},{"src":"/icons/pwa-192x192.avif","sizes":"192x192","type":"image/avif"},{"src":"/icons/pwa-192x192.png","sizes":"192x192","type":"image/png"},{"src":"/icons/pwa-144x144.avif","sizes":"144x144","type":"image/avif"},{"src":"/icons/pwa-144x144.png","sizes":"144x144","type":"image/png"},{"src":"/icons/pwa-96x96.avif","sizes":